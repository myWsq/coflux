{
  "name": "cofluxd",
  "version": "2.6.1",
  "description": "Coflux 无界面宿主（cofluxd）与统一操作工具（coflux）",
  "type": "module",
  "bin": {
    "cofluxd": "cofluxd.mjs",
    "coflux": "coflux.mjs"
  },
  "files": [
    "cofluxd.mjs",
    "coflux.mjs",
    "account-client.mjs",
    "release-pubkey.hex",
    "release-trust.mjs",
    "service-unit.mjs",
    "README.md",
    "skills",
    "executor"
  ],
  "scripts": {
    "prepack": "esbuild ../executor/src/host.ts ../executor/src/runner.ts --bundle --platform=node --target=node20 --format=esm --external:@earendil-works/pi-coding-agent --outdir=executor --log-level=warning"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "homepage": "https://github.com/myWsq/coflux#readme",
  "bugs": "https://github.com/myWsq/coflux/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myWsq/coflux.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "coflux",
    "daemon",
    "cli",
    "remote-terminal",
    "pty"
  ],
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
