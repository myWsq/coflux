<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 仅放 GENERATE_INFOPLIST_FILE 无法表达的键；其余键由构建设置生成后合并。
	     NSAllowsLocalNetworking：Debug 下模拟器连本机 dev server（ws://127.0.0.1）需要。
	     UIUserInterfaceStyle：全局锁暗色（2026-07-26 决策：终端本体永远黑底，
	     亮色 chrome 与黑终端割裂，遂放弃随系统主题）。 -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
</dict>
</plist>
