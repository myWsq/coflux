<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 仅放 GENERATE_INFOPLIST_FILE 无法表达的键；其余键由构建设置生成后合并。
	     NSAllowsLocalNetworking：Debug 下模拟器连本机 dev server（ws://127.0.0.1）需要。 -->
