<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 仅放 GENERATE_INFOPLIST_FILE 无法表达的键；其余键由构建设置生成后合并。
	     NSAllowsLocalNetworking：Debug 下模拟器连本机 dev server（ws://127.0.0.1）需要。
	     UIUserInterfaceStyle：全局锁暗色（2026-07-26 决策：终端本体永远黑底，
	     亮色 chrome 与黑终端割裂，遂放弃随系统主题）。 -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<!-- TestFlight/App Store 出口合规：仅用 HTTPS/WSS 标准加密（豁免类），免每次构建回答加密问题 -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- 终端长按对讲（plan 064）：占位条长按发起语音输入，转写结果落草稿供确认后发送 -->
	<key>NSMicrophoneUsageDescription</key>
	<string>用于长按占位条时录音，将语音转写为终端输入草稿</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>用于在语音转写服务不可用时，使用本机语音识别生成终端输入草稿</string>
</dict>
</plist>
